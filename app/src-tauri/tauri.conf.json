{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glint",
  "identifier": "dev.glint.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Glint",
        "width": 420,
        "height": 640,
        "minWidth": 380,
        "minHeight": 600,
        "maxWidth": 560,
        "center": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "windowEffects": {
          "effects": [
            "sidebar"
          ],
          "state": "active"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZDRjlGOEE5QjkwRTk4RkYKUldUL21BNjVxZmo1Yko4aE9RZk9sMU03cGxOd0JyTlRyUGJrelMyVE0xQ0hPQzN6L21WNEtSRXIK",
      "endpoints": [
        "https://github.com/thevrus/glint/releases/latest/download/latest.json"
      ]
    }
  }
}
